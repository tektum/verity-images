#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname "$0")" && pwd)

case "${1:-}" in
  "") ;;
  -h|--help)
    printf 'usage: ./check\n\nRun the complete local pre-PR verification suite.\n'
    exit 0
    ;;
  *)
    printf 'usage: ./check\n' >&2
    exit 2
    ;;
esac

"$root/scripts/devbox.sh" run lint

expected_fingerprint=764c84bdcf9ca8530146da9976d4cac4b37ba961ad258d589e9a11fb05206698
actual_fingerprint=$(openssl pkey -pubin -in "$root/packages/keys/verity-apk-2026.rsa.pub" \
  -pubout -outform DER | sha256sum | awk '{print $1}')
if [ "$actual_fingerprint" != "$expected_fingerprint" ]; then
  printf 'error: APK repository root fingerprint mismatch\n' >&2
  exit 1
fi
