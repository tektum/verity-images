{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": false,
  "platformAutomerge": false,
  "automergeType": "pr",
  "prCreation": "immediate",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": { "enabled": true },
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "image:\\s*(?<depName>\\S+):(?<currentValue>[^:@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "image:\\s*(?<depName>[^\\s@:]+(?:/[^\\s@:]+)*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "currentValueTemplate": "latest",
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^packages/repository-state\\.json$/"],
      "matchStrings": ["\\\"tag\\\": \\\"(?<currentValue>apk-repo-v[0-9]{4})\\\""],
      "depNameTemplate": "tektum/verity-images",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^apk-repo-v(?<major>[0-9]{4})$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images/.+$/", "/^packages/.+$/", "/^patched/.+$/"],
      "matchStrings": [
        "(?<currentValue>v?[0-9][0-9A-Za-z.+_-]*)[\"']?,?[ \\t]*#[ \\t]*renovate:[ \\t]*datasource=(?<datasource>\\S+)[ \\t]+depName=(?<depName>\\S+)(?:[ \\t]+versioning=(?<versioning>\\S+))?"
      ]
    }
  ],
  "packageRules": [
    {
      "matchFileNames": [".github/workflows/*.yaml"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchFileNames": ["packages/repository-state.json"],
      "automerge": false,
      "labels": ["apk-repository-state", "review-required"]
    },
    {
      "matchFileNames": ["images/**", "packages/**", "patched/**", "!packages/repository-state.json"],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest",
        "lockFileMaintenance",
        "rollback",
        "replacement"
      ],
      "enabled": false,
      "labels": ["security-floor", "review-required"]
    }
  ]
}
