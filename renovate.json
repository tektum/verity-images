{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": true,
  "platformAutomerge": true,
  "automergeType": "pr",
  "prCreation": "immediate",
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^patched/[^/]+/source\\.yaml$/"],
      "matchStrings": [
        "image:\\s*(?<depName>\\S+):(?<currentValue>\\S+)\\s*\\ndigest:\\s*(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "image:\\s*(?<depName>\\S+):(?<currentValue>[^:@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "image:\\s*(?<depName>[^\\s@:]+(?:/[^\\s@:]+)*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "currentValueTemplate": "latest",
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images/[^/]+/melange\\.yaml$/"],
      "matchStrings": [
        "(?<versionPrefix>version:\\s*\")(?<currentVersion>[^\"]+)(?<versionSuffix>\"[\\s\\S]*?repository:\\s*)(?<packageName>https://github\\.com/[^\\s]+)(?<commitPrefix>[\\s\\S]*?tag:\\s*v\\$\\{\\{package\\.version\\}\\}[\\s\\S]*?expected-commit:\\s*)(?<currentDigest>[a-f0-9]{40})"
      ],
      "currentValueTemplate": "v{{{currentVersion}}}",
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "autoReplaceStringTemplate": "{{{versionPrefix}}}{{{newVersion}}}{{{versionSuffix}}}{{{packageName}}}{{{commitPrefix}}}{{{newDigest}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images/cassandra/melange\\.yaml$/"],
      "matchStrings": [
        "(?<versionPrefix>version:\\s*\")(?<currentVersion>[^\"]+)(?<versionSuffix>\"[\\s\\S]*?repository:\\s*)(?<packageName>https://github\\.com/apache/cassandra)(?<commitPrefix>[\\s\\S]*?expected-commit:\\s*)(?<currentDigest>[a-f0-9]{40})(?<commitSuffix>[\\s\\S]*?tag:\\s*cassandra-\\$\\{\\{package\\.version\\}\\})"
      ],
      "currentValueTemplate": "{{{currentVersion}}}",
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^cassandra-(?<version>.*)$",
      "autoReplaceStringTemplate": "{{{versionPrefix}}}{{{newVersion}}}{{{versionSuffix}}}{{{packageName}}}{{{commitPrefix}}}{{{newDigest}}}{{{commitSuffix}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images/cluster-autoscaler/melange\\.yaml$/"],
      "matchStrings": [
        "(?<versionPrefix>version:\\s*\")(?<currentVersion>[^\"]+)(?<versionSuffix>\"[\\s\\S]*?repository:\\s*)(?<packageName>https://github\\.com/kubernetes/autoscaler)(?<commitPrefix>[\\s\\S]*?tag:\\s*cluster-autoscaler-\\$\\{\\{package\\.version\\}\\}[\\s\\S]*?expected-commit:\\s*)(?<currentDigest>[a-f0-9]{40})"
      ],
      "currentValueTemplate": "{{{currentVersion}}}",
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^cluster-autoscaler-(?<version>.*)$",
      "autoReplaceStringTemplate": "{{{versionPrefix}}}{{{newVersion}}}{{{versionSuffix}}}{{{packageName}}}{{{commitPrefix}}}{{{newDigest}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images/tidb/melange\\.yaml$/"],
      "matchStrings": [
        "(?<versionPrefix>version:\\s*\")(?<currentVersion>[^\"]+)(?<upstreamPrefix>\"[\\s\\S]*?upstream-version:\\s*)(?<upstreamVersion>[^\\s]+)(?<versionSuffix>[\\s\\S]*?repository:\\s*)(?<packageName>https://github\\.com/pingcap/tidb)(?<commitPrefix>[\\s\\S]*?tag:\\s*v\\$\\{\\{vars\\.upstream-version\\}\\}[\\s\\S]*?expected-commit:\\s*)(?<currentDigest>[a-f0-9]{40})"
      ],
      "currentValueTemplate": "v{{{upstreamVersion}}}",
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "autoReplaceStringTemplate": "{{{versionPrefix}}}{{{replace '-beta\\.' '_beta' newVersion}}}{{{upstreamPrefix}}}{{{newVersion}}}{{{versionSuffix}}}{{{packageName}}}{{{commitPrefix}}}{{{newDigest}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images/valkey/melange\\.yaml$/"],
      "matchStrings": [
        "(?<versionPrefix>version:\\s*\")(?<currentVersion>[^\"]+)(?<versionSuffix>\"[\\s\\S]*?repository:\\s*)(?<packageName>https://github\\.com/valkey-io/valkey)(?<commitPrefix>[\\s\\S]*?tag:\\s*\\$\\{\\{package\\.version\\}\\}[\\s\\S]*?expected-commit:\\s*)(?<currentDigest>[a-f0-9]{40})"
      ],
      "currentValueTemplate": "{{{currentVersion}}}",
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "{{{versionPrefix}}}{{{newVersion}}}{{{versionSuffix}}}{{{packageName}}}{{{commitPrefix}}}{{{newDigest}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images/zookeeper/melange\\.yaml$/"],
      "matchStrings": [
        "(?<versionPrefix>version:\\s*\")(?<currentVersion>[^\"]+)(?<versionSuffix>\"[\\s\\S]*?repository:\\s*)(?<packageName>https://github\\.com/apache/zookeeper)(?<commitPrefix>[\\s\\S]*?tag:\\s*release-\\$\\{\\{package\\.version\\}\\}[\\s\\S]*?expected-commit:\\s*)(?<currentDigest>[a-f0-9]{40})"
      ],
      "currentValueTemplate": "{{{currentVersion}}}",
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^release-(?<version>.*)$",
      "autoReplaceStringTemplate": "{{{versionPrefix}}}{{{newVersion}}}{{{versionSuffix}}}{{{packageName}}}{{{commitPrefix}}}{{{newDigest}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^packages/repository-state\\.json$/"],
      "matchStrings": ["\\\"tag\\\": \\\"(?<currentValue>apk-repo-v[0-9]{4})\\\""],
      "depNameTemplate": "tektum/verity-images",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^apk-repo-v(?<major>[0-9]{4})$"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": ["patched/**/source.yaml"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchFileNames": ["patched/busybox/source.yaml"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": false
    },
    {
      "matchFileNames": ["packages/repository-state.json"],
      "automerge": false,
      "labels": ["apk-repository-state", "review-required"]
    }
  ]
}
