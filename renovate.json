{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": false,
  "platformAutomerge": false,
  "automergeType": "pr",
  "prCreation": "immediate",
  "osvVulnerabilityAlerts": true,
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "image:\\s*(?<depName>\\S+):(?<currentValue>[^:@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "image:\\s*(?<depName>[^\\s@:]+(?:/[^\\s@:]+)*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "currentValueTemplate": "latest",
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^packages/repository-state\\.json$/"],
      "matchStrings": ["\\\"tag\\\": \\\"(?<currentValue>apk-repo-v[0-9]{4})\\\""],
      "depNameTemplate": "tektum/verity-images",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^apk-repo-v(?<major>[0-9]{4})$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^images/restic/melange\\.yaml$/",
        "/^packages/verity-restic-0\\.18/melange\\.yaml$/",
        "/^images/velero/melange\\.yaml$/"
      ],
      "matchStrings": ["grpc-floor:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "google.golang.org/grpc",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^packages/gosu/melange\\.yaml$/"],
      "matchStrings": ["x-sys-version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "golang.org/x/sys",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^patched/eck-operator/post-patch\\.Dockerfile$/"],
      "matchStrings": ["go get github\\.com/google/cel-go@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "github.com/google/cel-go",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^patched/eck-operator/post-patch\\.Dockerfile$/"],
      "matchStrings": ["google\\.golang\\.org/grpc@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "google.golang.org/grpc",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^patched/node-22-slim/post-patch\\.Dockerfile$/"],
      "matchStrings": ["npm install --global \\\"npm@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\\""],
      "depNameTemplate": "npm",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^patched/node-22-slim/post-patch\\.Dockerfile$/"],
      "matchStrings": ["\\\"(?<depName>ip-address|undici)@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\\""],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images/bat/melange\\.yaml$/"],
      "matchStrings": [
        "(?<depName>[a-z][a-z0-9_-]*)@[0-9]+\\.[0-9]+\\.[0-9]+=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^images/deno/melange\\.yaml$/",
        "/^images/vector/melange\\.yaml$/"
      ],
      "matchStrings": [
        "cargo update -p (?<depName>[a-z][a-z0-9_-]*)(?:@[0-9]+\\.[0-9]+\\.[0-9]+)? --precise (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images/cassandra/melange\\.yaml$/"],
      "matchStrings": [
        "\\(\\\"(?<group>[\\w.-]+)\\\",\\s*\\\"(?<artifact>[\\w.-]+)\\\"\\):\\s*\\\"(?<currentValue>[^\\\"]+)\\\""
      ],
      "depNameTemplate": "{{group}}:{{artifact}}",
      "datasourceTemplate": "maven"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": [".github/workflows/*.yaml"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchFileNames": ["packages/repository-state.json"],
      "automerge": false,
      "labels": ["apk-repository-state", "review-required"]
    },
    {
      "matchDatasources": ["go", "crate", "maven", "npm"],
      "enabled": false,
      "labels": ["security-floor", "review-required"]
    }
  ]
}
