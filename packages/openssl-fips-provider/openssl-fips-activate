#!/bin/sh
set -eu

runtime=${OPENSSL_FIPS_RUNTIME_DIR:?OPENSSL_FIPS_RUNTIME_DIR must name a writable runtime directory}
case "$runtime" in
  /*) ;;
  *) printf '%s\n' 'OPENSSL_FIPS_RUNTIME_DIR must be absolute' >&2; exit 64 ;;
esac
[ "$#" -gt 0 ] || { printf '%s\n' 'usage: openssl-fips-activate COMMAND [ARG...]' >&2; exit 64; }

original_umask=$(umask)
umask 077
work=$(mktemp -d "$runtime/openssl-fips.XXXXXX")
trap 'rm -rf "$work"' EXIT INT TERM
module=/usr/lib/ossl-modules/fips.so
expected=/usr/share/openssl-fips/fips.so.sha256
sha256sum -c "$expected"
openssl fipsinstall -module "$module" -out "$work/fipsmodule.cnf" -pedantic
openssl fipsinstall -module "$module" -in "$work/fipsmodule.cnf" -verify
sed "s|@FIPSMODULE@|$work/fipsmodule.cnf|" /usr/share/openssl-fips/openssl-fips.cnf.in >"$work/openssl.cnf"
OPENSSL_CONF="$work/openssl.cnf" openssl list -provider fips -providers >/dev/null
mv "$work/fipsmodule.cnf" "$runtime/fipsmodule.cnf"
sed "s|@FIPSMODULE@|$runtime/fipsmodule.cnf|" /usr/share/openssl-fips/openssl-fips.cnf.in >"$runtime/openssl.cnf"
trap - EXIT INT TERM
rm -rf "$work"
export OPENSSL_CONF="$runtime/openssl.cnf"
umask "$original_umask"
exec "$@"
