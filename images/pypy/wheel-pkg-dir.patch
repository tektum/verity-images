Tell ensurepip and venv where the system pip and setuptools wheels live.

ensurepip reads sysconfig's WHEEL_PKG_DIR and, when it is set, installs from
the wheels in that directory instead of the older copies bundled in
ensurepip/_bundled. The image removes those bundled copies and depends on the
Wolfi py3-pip-wheel and py3-setuptools-wheel packages.

--- a/lib_pypy/_sysconfigdata.py
+++ b/lib_pypy/_sysconfigdata.py
@@ -37,6 +37,7 @@
     'Py_DEBUG': 0,  # cpyext never uses this
     'Py_ENABLE_SHARED': 0,  # if 1, will add python so to link like -lpython3.7
     'SIZEOF_VOID_P': struct.calcsize("P"),
+    'WHEEL_PKG_DIR': "/usr/share/python-wheels",
 }
 
 # LIBDIR should point to where the libpypy3.11-c.so file lives, on CPython
