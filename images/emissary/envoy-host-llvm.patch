Build Envoy with the Wolfi LLVM 22 toolchain and V8 from source.

Follows Envoy's host-toolchain reference module (bazel/tests/codeql in
v1.40.2, "Building with host-provided toolchains" in bazel/README.md):
toolchains_llvm is rooted at the build environment's /usr/lib/llvm-22 and
envoy_llvm.host() points Envoy's direct LLVM references at the same
installation. The downloaded LLVM, libc++ and Debian sysroot archives are
dropped in favor of the Wolfi toolchain and glibc, as images/envoy does for
1.37. The wee8 engine is built from proxy-wasm-cpp-host source instead of
linking envoy_toolshed's prebuilt V8 static library.

diff --git a/MODULE.bazel b/MODULE.bazel
index b00debe1..57ba0e93 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -213,16 +213,6 @@ foreign_cc_tools.ninja(
 )
 
 llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
-llvm.cxx_cross_lib(
-    name = "llvm_toolchain",
-    label = "@libcxx_libs_aarch64",
-    targets = ["linux-aarch64"],
-)
-llvm.cxx_cross_lib(
-    name = "llvm_toolchain",
-    label = "@libcxx_libs_x86_64",
-    targets = ["linux-x86_64"],
-)
 llvm.toolchain(
     name = "llvm_toolchain",
     cxx_standard = {"": "c++20"},
@@ -231,28 +221,7 @@ llvm.toolchain(
 )
 llvm.toolchain_root(
     name = "llvm_toolchain",
-    label = "@llvm_minimal_linux_x64",
-    targets = ["linux-x86_64"],
-)
-llvm.toolchain_root(
-    name = "llvm_toolchain",
-    label = "@llvm_minimal_linux_arm64",
-    targets = ["linux-aarch64"],
-)
-llvm.toolchain_root(
-    name = "llvm_toolchain",
-    label = "@llvm_minimal_macos_arm64",
-    targets = ["darwin-aarch64"],
-)
-llvm.sysroot(
-    name = "llvm_toolchain",
-    label = "@sysroot_linux_amd64//:sysroot",
-    targets = ["linux-x86_64"],
-)
-llvm.sysroot(
-    name = "llvm_toolchain",
-    label = "@sysroot_linux_arm64//:sysroot",
-    targets = ["linux-aarch64"],
+    path = "/usr/lib/llvm-22",
 )
 use_repo(llvm, "llvm_toolchain")
 
@@ -273,6 +242,7 @@ llvm_minimal_ext.setup()
 use_repo(llvm_minimal_ext, "llvm_minimal_linux_arm64", "llvm_minimal_linux_x64", "llvm_minimal_macos_arm64")
 
 envoy_llvm_ext = use_extension("//bazel:extensions.bzl", "envoy_llvm_extension")
+envoy_llvm_ext.host(path = "/usr/lib/llvm-22")
 use_repo(envoy_llvm_ext, "llvm_toolchain_llvm")
 
 cc_configure = use_extension("@rules_cc//cc:extensions.bzl", "cc_configure_extension")
diff --git a/bazel/BUILD b/bazel/BUILD
index 81d16662..1fb70280 100644
--- a/bazel/BUILD
+++ b/bazel/BUILD
@@ -647,7 +647,7 @@ alias(
         ":asan_build": "@proxy-wasm-cpp-host//bazel:wee8_no_pointer_compression",
         ":msan_build": "@proxy-wasm-cpp-host//bazel:wee8_no_pointer_compression",
         ":tsan_build": "@proxy-wasm-cpp-host//bazel:wee8_no_pointer_compression",
-        "//conditions:default": "@envoy_toolshed//v8:wee8",
+        "//conditions:default": "@proxy-wasm-cpp-host//bazel:wee8_no_pointer_compression",
     }),
     visibility = ["//visibility:public"],
 )
