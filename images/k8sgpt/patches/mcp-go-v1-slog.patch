+func (z *zapSlogHandler) Enabled(_ context.Context, level slog.Level) bool {
+	return z.logger.Core().Enabled(zapLevel(level))
+}
+
+func (z *zapSlogHandler) Handle(_ context.Context, r slog.Record) error {
+	fields := append([]zap.Field(nil), z.fields...)
+	r.Attrs(func(a slog.Attr) bool {
+		fields = appendSlogAttr(fields, z.groups, a)
+		return true
+	})
+	z.logger.Log(zapLevel(r.Level), r.Message, fields...)
+	return nil
+}
+
+func (z *zapSlogHandler) WithAttrs(attrs []slog.Attr) slog.Handler {
+	clone := z.clone()
+	for _, a := range attrs {
+		clone.fields = appendSlogAttr(clone.fields, z.groups, a)
+	}
+	return clone
+}
+
+func (z *zapSlogHandler) WithGroup(name string) slog.Handler {
+	if name == "" {
+		return z
+	}
+	clone := z.clone()
+	clone.groups = append(clone.groups, name)
+	return clone
+}
+
+func (z *zapSlogHandler) clone() *zapSlogHandler {
+	clone := *z
+	clone.fields = append([]zap.Field(nil), z.fields...)
+	clone.groups = append([]string(nil), z.groups...)
+	return &clone
+}
+
+func appendSlogAttr(fields []zap.Field, groups []string, a slog.Attr) []zap.Field {
+	a.Value = a.Value.Resolve()
+	if a.Equal(slog.Attr{}) {
+		return fields
+	}
+	if a.Value.Kind() == slog.KindGroup {
+		if a.Key == "" {
+			for _, nested := range a.Value.Group() {
+				fields = appendSlogAttr(fields, groups, nested)
+			}
+			return fields
+		}
+		groups = append(groups[:len(groups):len(groups)], a.Key)
+		for _, nested := range a.Value.Group() {
+			fields = appendSlogAttr(fields, groups, nested)
+		}
+		return fields
+	}
+	key := strings.Join(append(groups[:len(groups):len(groups)], a.Key), ".")
+	return append(fields, zap.Any(key, a.Value.Any()))
+}
+
+func zapLevel(level slog.Level) zapcore.Level {
+	switch {
+	case level < slog.LevelInfo:
+		return zap.DebugLevel
+	case level < slog.LevelWarn:
+		return zap.InfoLevel
+	case level < slog.LevelError:
+		return zap.WarnLevel
+	default:
+		return zap.ErrorLevel
+	}
