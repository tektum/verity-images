{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "verity-vanity-registry",
  "account_id": "bcdd3f083f6cba90661189a9862b3641",
  "main": "worker.mjs",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "verity.supply/v2/*",
      "zone_name": "verity.supply"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
